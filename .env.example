APP_NAME=IGWA
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Gemini credentials (any number; a random healthy key is tried first per request). Use ONE of these forms
# (precedence: GEMINI_API_KEYS > GEMINI_API_KEY_1..10 > legacy GEMINI_API_KEY):
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# Failover tuning (seconds)
# GEMINI_REQUEST_TIMEOUT_SECONDS=150           # per attempt
# GEMINI_OVERALL_BUDGET_SECONDS=310            # whole failover chain; keep >= 2 x request timeout + margin
# GEMINI_MIN_ATTEMPT_SECONDS=15                # an attempt is not started with less budget left (no doomed call, no blame)
# GEMINI_SHARED_FAILURE_COOLDOWN_SECONDS=10
# GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
# GEMINI_QUOTA_COOLDOWN_SECONDS=3600
# GEMINI_BILLING_COOLDOWN_SECONDS=3600
# GEMINI_FORBIDDEN_COOLDOWN_SECONDS=3600
# Key selection / failover
# GEMINI_KEY_SELECTION=random                  # random (shuffled per request) | ordered (configured order)
# GEMINI_FAILOVER_ENABLED=true                 # false = one key only
# GEMINI_FAILOVER_DELAY_SECONDS=0              # pause between keys; 0 = switch immediately
# GEMINI_SHARED_FAILOVER_MAX_KEYS=2            # distinct keys tried after 5xx/timeout/network errors before the
#                                              # provider counts as down (1 = never rotate on those errors)
# GEMINI_MAX_INVALID_RESPONSE_ATTEMPTS=2       # keys tried when output is empty/truncated/invalid
# OCR_VALIDATE_RESPONSE=true                   # reject empty/truncated/invalid/incomplete Gemini output
# OCR_RETRY_FAILED_PAGES=true                  # re-OCR only missing pages / page by page after truncation
# OCR_OVERALL_DEADLINE_SECONDS=400             # OCR: Gemini + Groq together
# gemini-3.1-flash-lite: fast and verified. gemini-3-flash-preview is slower (~3x) but may read handwriting better.
# (gemini-3.8-flash / gemini-3.5-flash timed out on every key when tested; gemini-2.5-* is retired for new users.)
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

MAX_FILE_SIZE_MB=20

# --- OCR: Gemini (ordered key failover) -> Groq ---
OCR_ENABLE_GEMINI_FALLBACK=true
OCR_ENABLE_GROQ_FALLBACK=true
OCR_GROQ_MAX_RETRIES=1
